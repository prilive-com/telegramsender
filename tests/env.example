# Test Environment Configuration
# Copy this file to .env and fill in the values

# Valid bot token for testing (format: 123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ...)
TEST_BOT_TOKEN=

# Chat ID to send test messages to
TEST_CHAT_ID=

# Test photo URL (optional, uses placeholder if not set)
TEST_PHOTO_URL=

# Allowed photo directories for path validation tests (comma-separated)
TEST_ALLOWED_PHOTO_DIRS=/tmp,/app/uploads

# Base URL for Telegram API (default: https://api.telegram.org)
TEST_BASE_URL=https://api.telegram.org

# Log file path for tests
TEST_LOG_FILE_PATH=logs/test.log

# Timeouts and limits
TEST_REQUEST_TIMEOUT=10s
TEST_MAX_RETRIES=3
TEST_RATE_LIMIT_REQUESTS=10
TEST_RATE_LIMIT_BURST=20
